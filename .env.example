# Example configuration. Copy to .env and fill in.
#
# .env is gitignored and must never be committed. Every variable is validated at
# startup: the panel refuses to boot on a bad value and reports every problem it
# found at once, so a broken file is a one-pass fix.
#
# A blank value means "unset" and falls back to the default shown.

# ---------------------------------------------------------------- environment

# dev | prod. prod additionally forbids debug logging and insecure cookies.
APP_ENV=dev

# debug | info | warn | error. debug is rejected when APP_ENV=prod.
LOG_LEVEL=info

# json | text. Defaults to text in dev and json in prod.
LOG_FORMAT=

# ------------------------------------------------------------------- secrets

# REQUIRED. 32 bytes, as 64 hex characters or as base64.
#
# Encrypts every secret stored in the database (CA private key, Reality private
# keys, TOTP secrets, webhook secrets) and derives the JWT signing key, so there
# is exactly one secret to manage.
#
# Generate one:
#   openssl rand -hex 32
#
# Losing it means losing the CA (nodes re-enroll), Reality keys (client links must
# be reissued) and 2FA (admins re-enroll). Back it up separately from the database:
# a backup that contains both is a backup with the lock and the key in one box.
PANEL_SECRET_KEY=

# ------------------------------------------------------------------ database

# REQUIRED. Must be a postgres:// or postgresql:// URL.
DATABASE_URL=postgres://panel:panel@localhost:5432/panel?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s

# ---------------------------------------------------------------------- http

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Comma-separated CIDR blocks whose X-Forwarded-For header is believed.
#
# Leave empty unless the panel really sits behind a reverse proxy. This address
# feeds login throttling and the audit trail, so trusting the header from an
# arbitrary client would let an attacker spread brute-force attempts across
# unlimited fabricated addresses and forge audit entries.
#
# deploy/docker-compose.yml sets this itself to the subnet Caddy and the panel share
# (EDGE_SUBNET), so a production install does not need it here.
HTTP_TRUSTED_PROXIES=

# ---------------------------------------------------------------------- grpc

# Where nodes dial in. Nodes always initiate the connection, so this port is the
# panel's, not the node's, and it must be reachable from every node.
#
# Do not terminate TLS for it in a reverse proxy: the panel authenticates a node
# by its client certificate, and a proxy that terminates mTLS destroys that
# identity.
GRPC_ADDR=:8443
GRPC_SHUTDOWN_TIMEOUT=15s

# How often a connected node is told to report in, and how long silence is
# tolerated before its stream is torn down.
#
# The timeout must be longer than the interval, and is a multiple of it on purpose:
# one lost packet should not cost a node its connection, while a half-open TCP
# connection has to be noticed at all. Nothing below the application layer notices
# it reliably, so this is what does.
NODE_HEARTBEAT_INTERVAL=30s
NODE_HEARTBEAT_TIMEOUT=90s

# How long an enrollment token stays redeemable.
#
# It is a bearer secret worth a node's identity until it is used, so the window
# only has to cover the minutes between an operator minting it and the node
# starting. It is deliberately not a request parameter.
NODE_ENROLLMENT_TTL=1h

# Extra DNS names to put in the panel's gRPC certificate, comma-separated.
#
# Not needed for this project's own agent: a node requires the fixed internal name
# panel.xraypanel.internal in the panel's certificate regardless of the address it
# dials, so moving the panel needs no certificate work. This exists only for an
# operator who would rather have nodes verify a real DNS name as well.
GRPC_EXTRA_SERVER_NAMES=

# ---------------------------------------------------------------------- auth

AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

# Login throttling, per (username, IP).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW=15m
AUTH_LOGIN_LOCKOUT=15m

# Secure attribute on the refresh cookie. Defaults to true in prod, where it
# cannot be turned off. Only set false for local HTTP development.
AUTH_SECURE_COOKIES=

# Label shown for this panel in an administrator's authenticator app. Set it to
# this installation's hostname so someone running several panels can tell the
# entries apart at the moment they need to.
TOTP_ISSUER=xraypanel

# ----------------------------------------------------------------- bootstrap

# Seeds the first administrator on startup, and does nothing once any
# administrator exists. Both variables are required together; the password must be
# at least 12 characters.
#
# Remove them from the environment after the first successful login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --------------------------------------------------------------- subscription

# Advertised to clients as profile-update-interval, in hours. Lower means a revocation
# reaches a client sooner and more requests to the panel.
SUBSCRIPTION_UPDATE_HOURS=12

# The profile's name in clients that show one. Non-ASCII is fine; it is encoded for the
# header.
SUBSCRIPTION_PROFILE_TITLE=xraypanel

# The public /sub endpoint is limited per client address (per /64 for IPv6): this many
# requests a minute on average, with bursts up to the second value. A client refreshes a
# few times a day; the limit is for loops and token scans. Behind a reverse proxy it only
# works if HTTP_TRUSTED_PROXIES is set, otherwise every client shares the proxy's address.
SUBSCRIPTION_RATE_LIMIT=30
SUBSCRIPTION_RATE_BURST=20

# -------------------------------------------------------------------- billing

# IANA timezone that traffic-reset schedules are evaluated in. Stored timestamps
# stay UTC regardless of this setting.
BILLING_TIMEZONE=UTC

# ------------------------------------------------------------- traffic housekeeping

# How often the panel rolls hourly traffic up into days, creates the next months'
# partitions, and drops what has aged out. The first pass runs at startup.
TRAFFIC_MAINTENANCE_INTERVAL=1h

# How long the hourly rows are kept. They are the billing ledger and the largest
# table in the database; the daily rollup is what charts are drawn from and is not
# deleted, so this bounds the size without losing the history an operator reads.
TRAFFIC_RECORD_RETENTION=2160h

# How long a node's batch id is remembered so that a resend is recognised as a
# duplicate. It must outlive the longest outage during which a node could still be
# holding an unacknowledged batch: forgetting an id turns a resend into a user
# billed twice for the same bytes.
TRAFFIC_BATCH_RETENTION=48h

# How many monthly partitions to keep created in advance. Traffic with no partition
# of its own lands in the default one, which works and is slower to query.
TRAFFIC_PARTITIONS_AHEAD=3

# ---------------------------------------------------------------- enforcement

# How often over-limit and expired users are switched off and finished billing periods
# are reset. Together with the nodes' traffic poll this bounds how far past their limit
# a user can get: with every interval at its default, about two minutes of traffic.
ENFORCEMENT_INTERVAL=30s

# ------------------------------------------------------------------- webhooks

# How often the delivery queue is checked.
WEBHOOK_INTERVAL=5s

# A receiver slower than this is treated as down for that attempt.
WEBHOOK_TIMEOUT=10s

# Attempts before a delivery is given up on. Retries double from 30 seconds up to six
# hours, so twelve attempts cover about fourteen and a half hours - long enough for a
# receiver that is down overnight. Fewer is a shorter window, not a faster one.
WEBHOOK_MAX_ATTEMPTS=12

# How long delivered rows are kept for an operator to look at. Undelivered ones are
# kept regardless: they are evidence.
WEBHOOK_RETENTION=168h
