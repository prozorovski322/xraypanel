# Production settings for deploy/docker-compose.yml. Copy to .env next to it and fill in.
#
# .env is gitignored. It holds the two secrets of the installation; keep a copy of it
# somewhere other than this server, separately from the database backups.

# ------------------------------------------------------------------ required

# The panel's public name. Its A/AAAA record must point at this server before the first
# start: Caddy obtains the certificate for it on its own.
PANEL_DOMAIN=panel.example.com

# Hex only, so it can sit in a URL without escaping:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts every secret in the database and signs sessions. 32 bytes:
#   openssl rand -hex 32
# Losing it means re-enrolling every node, reissuing Reality keys and resetting 2FA.
PANEL_SECRET_KEY=

# The first administrator, created on the first start only. Remove both lines after
# signing in for the first time. At least 12 characters.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------------ images

# Pin a release tag rather than following latest, so that an upgrade happens when you run
# it and not when a container happens to be recreated.
XRAYPANEL_VERSION=latest
# IMAGE_REGISTRY=ghcr.io/prozorovski322

# ------------------------------------------------------------------ network

# Where nodes connect. Open it in the firewall for your nodes' addresses.
NODE_PORT=8443

# The compose network Caddy and the panel share. Change only if it collides with a network
# this host already uses.
EDGE_SUBNET=172.31.250.0/24

# ------------------------------------------------------------------ panel

# Shown in administrators' authenticator apps; use this installation's name.
TOTP_ISSUER=panel.example.com

# The timezone traffic resets are counted in.
BILLING_TIMEZONE=UTC

# What subscribers see as the profile's name.
SUBSCRIPTION_PROFILE_TITLE=xraypanel

# Every other panel setting from the repository's .env.example can be added here as well.

# ------------------------------------------------------------------ backups

BACKUP_INTERVAL=24h
BACKUP_KEEP=14
BACKUP_MAX_AGE=720h
