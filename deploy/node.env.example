# Example configuration for a node. Copy onto the node and fill in.
#
# All three of the required values come from one call to the panel:
#
#   curl -s -X POST https://panel.example.com/api/v1/nodes/{id}/enrollment-tokens \
#     -H "Authorization: Bearer $ACCESS"
#
# The agent validates everything at startup and refuses to run on a bad value,
# reporting every problem at once.

# REQUIRED. host:port of the panel's node port. Not the HTTP port: nodes speak gRPC
# with mutual TLS, and that port must not be behind a TLS-terminating proxy.
NODE_PANEL_ADDR=panel.example.com:8443

# REQUIRED. The panel authority's public-key fingerprint, as 64 hex characters.
#
# This is what lets the node verify the panel before it sends its enrollment token. A
# node that cannot do that hands the token — and with it its identity and every user
# credential the panel later sends it — to whoever answers on the address above.
#
# Required even after enrollment: an agent that forgot it would have to trust whoever
# answers the next time it re-enrols. Readable at any time from GET /api/v1/pki/ca.
NODE_CA_PIN=

# Single-use, and only needed until this node has a certificate. Leaving it set
# afterwards does nothing; removing it is tidier.
NODE_ENROLLMENT_TOKEN=

# Identity, the configuration the panel sent, and the local cache. Must be a volume:
# losing it means enrolling this node again by hand.
NODE_DATA_DIR=/var/lib/xraypanel-node

NODE_XRAY_BINARY=/usr/local/bin/xray

# Used only until the panel states its own interval, which it does on every connection.
NODE_HEARTBEAT_INTERVAL=30s

# Bounds on the reconnect delay. The delay is jittered, because every node on an
# installation reconnects the moment the panel comes back, and without jitter they all
# arrive at the same instant.
NODE_RECONNECT_MIN=1s
NODE_RECONNECT_MAX=1m

NODE_LOG_LEVEL=info
NODE_LOG_FORMAT=json

# How often the core's traffic counters are read. Shorter means finer-grained billing
# and more work; longer means more traffic at risk, because what the core counted
# since the last poll is what a crash of the core costs.
NODE_STATS_INTERVAL=30s

# delta|reset. delta reads counters without zeroing them and computes the difference,
# which is what makes a crash of the agent or the panel cost nobody anything. reset is
# the escape hatch for an installation where that misbehaves, and it loses whatever was
# read but not yet reported. See docs/traffic.md.
NODE_STATS_STRATEGY=delta
